{
  "name": "ai-stock-research-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc && vite build --configLoader runner",
    "preview": "vite preview --host 127.0.0.1",
    "generate": "tsx scripts/generateDailyReport.ts",
    "practice-real": "tsx scripts/generatePracticeRealReport.ts",
    "automation:once": "tsx scripts/runOneTimeResearchAutomation.ts",
    "automation:morning": "tsx scripts/runOneTimeResearchAutomation.ts --mode=morning",
    "automation:evening": "tsx scripts/runOneTimeResearchAutomation.ts --mode=evening"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.4",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.2"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^7.1.3"
  }
}
